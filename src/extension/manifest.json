{
  "manifest_version": 3,
  "name": "Video2Skill",
  "version": "0.1.0",
  "description": "Practice the fixed Bilibili web-card lesson alongside the video.",
  "permissions": ["sidePanel", "storage", "tabs"],
  "host_permissions": ["https://www.bilibili.com/*", "http://127.0.0.1:8765/*"],
  "background": { "service_worker": "background.mjs", "type": "module" },
  "side_panel": { "default_path": "sidepanel.html" },
  "content_scripts": [{ "matches": ["https://www.bilibili.com/video/*"], "js": ["content.mjs"], "run_at": "document_idle" }]
}
